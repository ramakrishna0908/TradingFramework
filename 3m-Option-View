//@version=5
indicator("CPR Breakout DEBUG (PDH/PDL/R1/S1 + VWAP)", overlay=true, max_labels_count=500)

// ===========================
// Inputs
// ===========================
sessionInput       = input.session("0930-1600", "Regular Session")
volLen             = input.int(20, "Volume MA Length", minval=1)
volMult            = input.float(1.1, "Volume Multiplier", minval=0.1, step=0.1)
respectBias        = input.bool(true, "Respect Opening Bias Filter")
oneSignalPerDirDay = input.bool(true, "One Signal Per Direction Per Day")

debugMode          = input.bool(true, "Debug Mode (show gate markers)")
allowOutOfSession  = input.bool(true, "DEBUG: Allow signals outside session")
ignoreVolumeGate   = input.bool(false, "DEBUG: Ignore volume gate")
ignoreBiasGate     = input.bool(true, "DEBUG: Ignore bias gate")
ignoreDailyLimit   = input.bool(true, "DEBUG: Ignore one-signal-per-day")

showValuesLabel    = input.bool(true, "Show Last-Bar Debug Label")
showLevelPlots     = input.bool(true, "Plot Levels")
showJsonAlerts     = input.bool(false, "Send JSON alert() payloads")

// ===========================
// Session state
// ===========================
inSession = not na(time(timeframe.period, sessionInput))
newSessionBar = inSession and not inSession[1]

// ===========================
// Previous-day levels
// ===========================
pdh = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on)
pdc = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

// CPR
pivot = (pdh + pdl + pdc) / 3.0
bcRaw = (pdh + pdl) / 2.0
tcRaw = 2.0 * pivot - bcRaw
tc = math.max(tcRaw, bcRaw)
bc = math.min(tcRaw, bcRaw)

// R1 / S1
r1 = 2.0 * pivot - pdl
s1 = 2.0 * pivot - pdh

// VWAP
vwapVal = ta.vwap(hlc3)

// ===========================
// Helpers
// ===========================
brokeAbove(level) =>
    close > level and close[1] <= level

brokeBelow(level) =>
    close < level and close[1] >= level

volMA = ta.sma(volume, volLen)
volOkRaw = volume >= volMA * volMult
volOk = ignoreVolumeGate ? true : volOkRaw

sessionOk = allowOutOfSession ? true : inSession

// ===========================
// Bias state machine
// ===========================
var string openingBias = "UNSET"  // BULLISH / BEARISH / RANGE
var string activeBias  = "UNSET"  // BULLISH / BEARISH / RANGE
var bool callFiredToday = false
var bool putFiredToday  = false

if newSessionBar
    openingBias := open > tc ? "BULLISH" : open < bc ? "BEARISH" : "RANGE"
    activeBias  := openingBias
    callFiredToday := false
    putFiredToday  := false

// If opened in CPR range, wait for a close outside CPR boundaries.
if sessionOk and activeBias == "RANGE"
    if close > tc
        activeBias := "BULLISH"
    else if close < bc
        activeBias := "BEARISH"

// ===========================
// Break logic
// ===========================
crossPDH = brokeAbove(pdh)
crossR1  = brokeAbove(r1)
crossPDL = brokeBelow(pdl)
crossS1  = brokeBelow(s1)

bullBreakRaw = (crossPDH or crossR1) and barstate.isconfirmed
bearBreakRaw = (crossPDL or crossS1) and barstate.isconfirmed

breakOkBull = bullBreakRaw
breakOkBear = bearBreakRaw

// Bias gate (strict if respectBias is on)
biasAllowsCallRaw = activeBias == "BULLISH"
biasAllowsPutRaw  = activeBias == "BEARISH"

biasAllowsCall =
     ignoreBiasGate ? true :
     (respectBias ? biasAllowsCallRaw : true)

biasAllowsPut =
     ignoreBiasGate ? true :
     (respectBias ? biasAllowsPutRaw : true)

// Daily one-signal-per-direction gate
dailyCallOkRaw = not callFiredToday
dailyPutOkRaw  = not putFiredToday

dailyCallOk =
     ignoreDailyLimit ? true :
     (oneSignalPerDirDay ? dailyCallOkRaw : true)

dailyPutOk =
     ignoreDailyLimit ? true :
     (oneSignalPerDirDay ? dailyPutOkRaw : true)

// Final signals
callSignal = sessionOk and volOk and breakOkBull and biasAllowsCall and dailyCallOk
putSignal  = sessionOk and volOk and breakOkBear and biasAllowsPut  and dailyPutOk

if callSignal
    callFiredToday := true
if putSignal
    putFiredToday := true

// ===========================
// Global-scope plots only
// ===========================
// Levels
plot(series = showLevelPlots ? pdh : na, title = "PDH", color = color.new(color.green, 0), linewidth = 1, style = plot.style_line)
plot(series = showLevelPlots ? pdl : na, title = "PDL", color = color.new(color.red, 0), linewidth = 1, style = plot.style_line)
plot(series = showLevelPlots ? tc  : na, title = "TC",  color = color.new(color.orange, 0), linewidth = 1, style = plot.style_line)
plot(series = showLevelPlots ? bc  : na, title = "BC",  color = color.new(color.orange, 0), linewidth = 1, style = plot.style_line)
plot(series = showLevelPlots ? r1  : na, title = "R1",  color = color.new(color.lime, 20), linewidth = 1, style = plot.style_line)
plot(series = showLevelPlots ? s1  : na, title = "S1",  color = color.new(color.maroon, 20), linewidth = 1, style = plot.style_line)

// Final markers
plotshape(callSignal, title="CALL Final", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.small, text="CALL")
plotshape(putSignal,  title="PUT Final",  style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="PUT")

// Debug gate markers
// plotshape(debugMode and sessionOk,    title="GATE Session",   style=shape.circle,  location=location.bottom,   color=color.new(color.aqua, 0),   size=size.tiny, text="S")
// plotshape(debugMode and volOk,        title="GATE Volume",    style=shape.circle,  location=location.bottom,   color=color.new(color.yellow, 0), size=size.tiny, text="V")
// plotshape(debugMode and breakOkBull,  title="GATE BullBreak", style=shape.square,  location=location.belowbar, color=color.new(color.green, 30), size=size.tiny, text="B+")
// plotshape(debugMode and breakOkBear,  title="GATE BearBreak", style=shape.square,  location=location.abovebar, color=color.new(color.red, 30),   size=size.tiny, text="B-")
// plotshape(debugMode and biasAllowsCall, title="GATE BiasCall", style=shape.diamond, location=location.belowbar, color=color.new(color.green, 60), size=size.tiny, text="C")
// plotshape(debugMode and biasAllowsPut,  title="GATE BiasPut",  style=shape.diamond, location=location.abovebar, color=color.new(color.red, 60),   size=size.tiny, text="P")
// plotshape(debugMode and dailyCallOk,  title="GATE DailyCall", style=shape.cross,   location=location.belowbar, color=color.new(color.green, 0),  size=size.tiny, text="D")
// plotshape(debugMode and dailyPutOk,   title="GATE DailyPut",  style=shape.cross,   location=location.abovebar, color=color.new(color.red, 0),    size=size.tiny, text="D")

// ===========================
// Last-bar debug label
// ===========================
if showValuesLabel and barstate.islast
    txt = "inSession=" + str.tostring(inSession) +
          "\nsessionOk=" + str.tostring(sessionOk) +
          "\nvol=" + str.tostring(volume) +
          "\nvolMA=" + str.tostring(volMA) +
          "\nvolOkRaw=" + str.tostring(volOkRaw) +
          "\nvolOk=" + str.tostring(volOk) +
          "\nopeningBias=" + openingBias +
          "\nactiveBias=" + activeBias +
          "\ncrossPDH=" + str.tostring(crossPDH) +
          "\ncrossR1=" + str.tostring(crossR1) +
          "\ncrossPDL=" + str.tostring(crossPDL) +
          "\ncrossS1=" + str.tostring(crossS1) +
          "\nbullBreakRaw=" + str.tostring(bullBreakRaw) +
          "\nbearBreakRaw=" + str.tostring(bearBreakRaw) +
          "\nbiasAllowsCall=" + str.tostring(biasAllowsCall) +
          "\nbiasAllowsPut=" + str.tostring(biasAllowsPut) +
          "\ncallFiredToday=" + str.tostring(callFiredToday) +
          "\nputFiredToday=" + str.tostring(putFiredToday)
    label.new(bar_index, high, txt, style=label.style_label_left, textcolor=color.white, color=color.new(color.black, 60))

// ===========================
// Alert conditions
// ===========================
alertcondition(callSignal, "CALL_SIGNAL_DEBUG", "CALL_SIGNAL_DEBUG")
alertcondition(putSignal,  "PUT_SIGNAL_DEBUG",  "PUT_SIGNAL_DEBUG")

// ===========================
// Optional dynamic JSON alerts
// ===========================
if showJsonAlerts and callSignal
    callJson = "{" +
         "\"strategy\":\"cpr_breakout_v1\"," +
         "\"signal_id\":\"" + syminfo.ticker + "-" + timeframe.period + "-" + str.tostring(time) + "-CALL\"," +
         "\"symbol\":\"" + syminfo.ticker + "\"," +
         "\"timeframe\":\"" + timeframe.period + "\"," +
         "\"action\":\"CALL_SIGNAL\"," +
         "\"bar_time\":\"" + str.tostring(time) + "\"," +
         "\"close\":" + str.tostring(close) + "," +
         "\"volume\":" + str.tostring(volume) + "," +
         "\"trigger\":\"PDH_OR_R1_BREAK\"," +
         "\"opening_bias\":\"" + openingBias + "\"," +
         "\"active_bias\":\"" + activeBias + "\"" +
         "}"
    alert(callJson, alert.freq_once_per_bar_close)

if showJsonAlerts and putSignal
    putJson = "{" +
         "\"strategy\":\"cpr_breakout_v1\"," +
         "\"signal_id\":\"" + syminfo.ticker + "-" + timeframe.period + "-" + str.tostring(time) + "-PUT\"," +
         "\"symbol\":\"" + syminfo.ticker + "\"," +
         "\"timeframe\":\"" + timeframe.period + "\"," +
         "\"action\":\"PUT_SIGNAL\"," +
         "\"bar_time\":\"" + str.tostring(time) + "\"," +
         "\"close\":" + str.tostring(close) + "," +
         "\"volume\":" + str.tostring(volume) + "," +
         "\"trigger\":\"PDL_OR_S1_BREAK\"," +
         "\"opening_bias\":\"" + openingBias + "\"," +
         "\"active_bias\":\"" + activeBias + "\"" +
         "}"
    alert(putJson, alert.freq_once_per_bar_close)