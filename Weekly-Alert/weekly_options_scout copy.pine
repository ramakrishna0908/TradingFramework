//@version=6
indicator("Weekly Options Scout — 20 Tickers + Discord", overlay=true, max_bars_back=500)

// ── Weights (constants, max total = 11) ──────────────────────────────────────
W_CPR = 3   // momentary — strongest structural signal
W_VOL = 2   // momentary — conviction behind the move
W_BB  = 2   // momentary — statistical outlier move
W_EMA = 1   // persistent — trend backdrop
W_RSI = 1   // persistent — momentum filter
W_CMF = 1   // persistent — institutional flow
W_ICH = 1   // persistent — trend structure

// ── Signal Filters ───────────────────────────────────────────────────────────
var g1 = "Signal Filters — uncheck to disable"
use_cpr  = input.bool(true, "CPR Breakout  [3 pts — structural anchor]", group=g1)
use_vol  = input.bool(true, "Volume Surge  [2 pts — conviction filter]",  group=g1)
use_bb   = input.bool(true, "Bollinger Bands  [2 pts — outlier move]",    group=g1)
use_ema  = input.bool(true, "EMA Cross  [1 pt — trend backdrop]",         group=g1)
use_rsi  = input.bool(true, "RSI Momentum  [1 pt]",                       group=g1)
use_cmf  = input.bool(true, "Chaikin Money Flow  [1 pt]",                 group=g1)
use_ichi = input.bool(true, "Ichimoku Trend  [1 pt]",                     group=g1)

// ── Indicator Parameters ─────────────────────────────────────────────────────
var g2 = "Indicator Parameters"
ema_f  = input.int(20,    "EMA Fast Period",    minval=5,             group=g2)
ema_s  = input.int(50,    "EMA Slow Period",    minval=10,            group=g2)
bb_l   = input.int(20,    "BB Length",          minval=5,             group=g2)
bb_m   = input.float(2.0, "BB StdDev",          step=0.5,             group=g2)
rsi_l  = input.int(14,    "RSI Length",         minval=2,             group=g2)
rsi_b  = input.int(55,    "RSI Bullish Level",  minval=50, maxval=80, group=g2)
rsi_br = input.int(45,    "RSI Bearish Level",  minval=20, maxval=50, group=g2)
cmf_l  = input.int(20,    "CMF Length",         minval=5,             group=g2)
cmf_t  = input.float(0.05,"CMF Threshold",      step=0.01,            group=g2)
vol_m  = input.float(1.5, "Volume Surge Mult",  step=0.1,             group=g2)
min_sc = input.int(7,     "Min Score to Alert", minval=1, maxval=11,  group=g2, tooltip="Score out of 11 max. CPR=3, Vol=2, BB=2, EMA/RSI/CMF/ICH=1 each. Recommended: 7 for solid setups, 9+ for high conviction only.")
cbar   = input.int(1,     "Confirmation Bars",  minval=1, maxval=3,   group=g2)

// ── Options Settings ─────────────────────────────────────────────────────────
var g3 = "Options Settings"
otm_p = input.float(1.0, "OTM Strike % from price", step=0.5, group=g3)
dte_i = input.int(7,     "Days to Expiry (DTE)",    minval=1, maxval=60, group=g3)

// ── Debug ────────────────────────────────────────────────────────────────────
var g4 = "Debug"
show_dbg = input.bool(false, "Show score dashboard (bottom-right) + console log", group=g4, tooltip="Draws a live per-indicator breakdown table at bottom-right for the chart symbol. Also logs to Pine console on each confirmed bar.")

// ── Helpers ──────────────────────────────────────────────────────────────────
_mn(int m) => m == 1 ? "JAN" : m == 2 ? "FEB" : m == 3 ? "MAR" : m == 4 ? "APR" : m == 5 ? "MAY" : m == 6 ? "JUN" : m == 7 ? "JUL" : m == 8 ? "AUG" : m == 9 ? "SEP" : m == 10 ? "OCT" : m == 11 ? "NOV" : "DEC"

ets  = time + dte_i * 86400000
elbl = _mn(month(ets)) + " " + str.tostring(dayofmonth(ets))
NL   = "\\n"

_cf(int sc)        => sc >= 9 ? "HIGH" : sc >= 6 ? "MED" : "LOW"
_prem(float atr)   => str.tostring(math.max(atr * 0.35, 0.10), "#.##")
_ck(bool b, int w) => b ? "✅ +" + str.tostring(w) : "❌  0"

// ── Scanner ──────────────────────────────────────────────────────────────────
f_scan(string sym) =>
    [dH, dL, dC, dV, pH, pL, pC, vsma, atr14, rsi_v, ef, es, bbu, bbl, cmf_v, ich_c, ich_b] = request.security(sym, "D", [high, low, close, volume, high[1], low[1], close[1], ta.sma(volume, 20), ta.atr(14), ta.rsi(close, rsi_l), ta.ema(close, ema_f), ta.ema(close, ema_s), ta.sma(close, bb_l) + bb_m * ta.stdev(close, bb_l), ta.sma(close, bb_l) - bb_m * ta.stdev(close, bb_l), ta.sma((high - low) > 0 ? ((close - low) - (high - close)) / (high - low) * volume : 0.0, cmf_l) / math.max(ta.sma(volume, cmf_l), 1), (ta.highest(high, 9) + ta.lowest(low, 9)) / 2, (ta.highest(high, 26) + ta.lowest(low, 26)) / 2], lookahead=barmerge.lookahead_off)

    pp   = (pH + pL + pC) / 3
    bc   = (pH + pL) / 2
    tc   = 2 * pp - bc
    r1   = 2 * pp - pL
    s1   = 2 * pp - pH
    r2   = pp + (pH - pL)
    s2   = pp - (pH - pL)

    cbull = use_cpr  and dC > tc                        ? W_CPR : 0
    cbear = use_cpr  and dC < bc                        ? W_CPR : 0
    bbull = use_bb   and dC > bbu                       ? W_BB  : 0
    bbear = use_bb   and dC < bbl                       ? W_BB  : 0
    ebull = use_ema  and ef > es and dC > ef            ? W_EMA : 0
    ebear = use_ema  and ef < es and dC < ef            ? W_EMA : 0
    rbull = use_rsi  and rsi_v > rsi_b                  ? W_RSI : 0
    rbear = use_rsi  and rsi_v < rsi_br                 ? W_RSI : 0
    cfbul = use_cmf  and cmf_v >  cmf_t                 ? W_CMF : 0
    cfbea = use_cmf  and cmf_v < -cmf_t                 ? W_CMF : 0
    ibull = use_ichi and dC > ich_c and ich_c > ich_b   ? W_ICH : 0
    ibear = use_ichi and dC < ich_c and ich_c < ich_b   ? W_ICH : 0
    vbull = use_vol  and dV > vsma * vol_m and dC > tc  ? W_VOL : 0
    vbear = use_vol  and dV > vsma * vol_m and dC < bc  ? W_VOL : 0

    bsc  = cbull + bbull + ebull + rbull + cfbul + ibull + vbull
    esc  = cbear + bbear + ebear + rbear + cfbea + ibear + vbear
    rt   = dC >= 50 ? 5.0 : 1.0
    putk = math.floor(dC * (1 - otm_p / 100) / rt) * rt
    calk = math.ceil( dC * (1 + otm_p / 100) / rt) * rt

    [dC, bsc, esc, bc, tc, s1, s2, r1, r2, atr14, rsi_v, dV > vsma * vol_m, putk, calk]

// ── Unpack — 20 tickers ──────────────────────────────────────────────────────
[p1,  bu1,  be1,  bc1,  tc1,  s11,  s21,  r11,  r21,  a1,  rs1,  v1,  pk1,  ck1]  = f_scan("AMEX:SPY")
[p2,  bu2,  be2,  bc2,  tc2,  s12,  s22,  r12,  r22,  a2,  rs2,  v2,  pk2,  ck2]  = f_scan("NASDAQ:QQQ")
[p3,  bu3,  be3,  bc3,  tc3,  s13,  s23,  r13,  r23,  a3,  rs3,  v3,  pk3,  ck3]  = f_scan("AMEX:IWM")
[p4,  bu4,  be4,  bc4,  tc4,  s14,  s24,  r14,  r24,  a4,  rs4,  v4,  pk4,  ck4]  = f_scan("NASDAQ:AAPL")
[p5,  bu5,  be5,  bc5,  tc5,  s15,  s25,  r15,  r25,  a5,  rs5,  v5,  pk5,  ck5]  = f_scan("NASDAQ:NVDA")
[p6,  bu6,  be6,  bc6,  tc6,  s16,  s26,  r16,  r26,  a6,  rs6,  v6,  pk6,  ck6]  = f_scan("NASDAQ:TSLA")
[p7,  bu7,  be7,  bc7,  tc7,  s17,  s27,  r17,  r27,  a7,  rs7,  v7,  pk7,  ck7]  = f_scan("NASDAQ:AMZN")
[p8,  bu8,  be8,  bc8,  tc8,  s18,  s28,  r18,  r28,  a8,  rs8,  v8,  pk8,  ck8]  = f_scan("NASDAQ:META")
[p9,  bu9,  be9,  bc9,  tc9,  s19,  s29,  r19,  r29,  a9,  rs9,  v9,  pk9,  ck9]  = f_scan("NASDAQ:MSFT")
[p10, bu10, be10, bc10, tc10, s110, s210, r110, r210, a10, rs10, v10, pk10, ck10] = f_scan("NASDAQ:GOOGL")
[p11, bu11, be11, bc11, tc11, s111, s211, r111, r211, a11, rs11, v11, pk11, ck11] = f_scan("NASDAQ:AMD")
[p12, bu12, be12, bc12, tc12, s112, s212, r112, r212, a12, rs12, v12, pk12, ck12] = f_scan("NASDAQ:COIN")
[p13, bu13, be13, bc13, tc13, s113, s213, r113, r213, a13, rs13, v13, pk13, ck13] = f_scan("NASDAQ:PLTR")
[p14, bu14, be14, bc14, tc14, s114, s214, r114, r214, a14, rs14, v14, pk14, ck14] = f_scan("NASDAQ:NFLX")
[p15, bu15, be15, bc15, tc15, s115, s215, r115, r215, a15, rs15, v15, pk15, ck15] = f_scan("NASDAQ:AVGO")
[p16, bu16, be16, bc16, tc16, s116, s216, r116, r216, a16, rs16, v16, pk16, ck16] = f_scan("NYSE:BA")
[p17, bu17, be17, bc17, tc17, s117, s217, r117, r217, a17, rs17, v17, pk17, ck17] = f_scan("NASDAQ:INTC")
[p18, bu18, be18, bc18, tc18, s118, s218, r118, r218, a18, rs18, v18, pk18, ck18] = f_scan("NYSE:BAC")
[p19, bu19, be19, bc19, tc19, s119, s219, r119, r219, a19, rs19, v19, pk19, ck19] = f_scan("NASDAQ:MU")
[p20, bu20, be20, bc20, tc20, s120, s220, r120, r220, a20, rs20, v20, pk20, ck20] = f_scan("NYSE:DIS")

// ── Alert Function ───────────────────────────────────────────────────────────
f_alert(string sym, float pr, int bsc, int esc, float bc, float tc, float s1, float s2, float r1, float r2, float atr, float putk, float calk) =>
    ba   = bsc >= min_sc
    ea   = esc >= min_sc
    bk   = ba and (cbar < 2 or bsc[1] >= min_sc) and (cbar < 3 or bsc[2] >= min_sc)
    ek   = ea and (cbar < 2 or esc[1] >= min_sc) and (cbar < 3 or esc[2] >= min_sc)
    bf   = bk and not (bsc[cbar] >= min_sc)
    ef   = ek and not (esc[cbar] >= min_sc)
    prem = _prem(atr)
    cbs  = str.tostring(cbar)
    cfs  = _cf(math.max(bsc, esc))
    smax = str.tostring(math.max(bsc, esc)) + "/11"

    if bf
        sig = pr > tc ? "CPR TC Break" : "EMA + Momentum"
        alert('{"content":"@bot BOUGHT | ' + sym + " " + elbl + " " + str.tostring(calk, "#") + "C $" + prem + NL + "Signal: " + sig + " [" + cfs + " conf] Score " + smax + " (" + cbs + "-bar confirmed)" + NL + "Trigger: $" + str.tostring(tc, "#.##") + " (TC) cleared" + NL + "Targets: R1 $" + str.tostring(r1, "#.##") + " R2 $" + str.tostring(r2, "#.##") + NL + "Stop: Below TC $" + str.tostring(tc, "#.##") + '"}', alert.freq_once_per_bar)

    if ef
        sig = pr < bc ? "CPR BC Break" : "EMA + Momentum"
        alert('{"content":"@bot BOUGHT | ' + sym + " " + elbl + " " + str.tostring(putk, "#") + "P $" + prem + NL + "Signal: " + sig + " [" + cfs + " conf] Score " + smax + " (" + cbs + "-bar confirmed)" + NL + "Trigger: $" + str.tostring(bc, "#.##") + " (BC) broken" + NL + "Targets: S1 $" + str.tostring(s1, "#.##") + " S2 $" + str.tostring(s2, "#.##") + NL + "Stop: Above BC $" + str.tostring(bc, "#.##") + '"}', alert.freq_once_per_bar)

// ── Fire Alerts ──────────────────────────────────────────────────────────────
f_alert("SPY",   p1,  bu1,  be1,  bc1,  tc1,  s11,  s21,  r11,  r21,  a1,  pk1,  ck1)
f_alert("QQQ",   p2,  bu2,  be2,  bc2,  tc2,  s12,  s22,  r12,  r22,  a2,  pk2,  ck2)
f_alert("IWM",   p3,  bu3,  be3,  bc3,  tc3,  s13,  s23,  r13,  r23,  a3,  pk3,  ck3)
f_alert("AAPL",  p4,  bu4,  be4,  bc4,  tc4,  s14,  s24,  r14,  r24,  a4,  pk4,  ck4)
f_alert("NVDA",  p5,  bu5,  be5,  bc5,  tc5,  s15,  s25,  r15,  r25,  a5,  pk5,  ck5)
f_alert("TSLA",  p6,  bu6,  be6,  bc6,  tc6,  s16,  s26,  r16,  r26,  a6,  pk6,  ck6)
f_alert("AMZN",  p7,  bu7,  be7,  bc7,  tc7,  s17,  s27,  r17,  r27,  a7,  pk7,  ck7)
f_alert("META",  p8,  bu8,  be8,  bc8,  tc8,  s18,  s28,  r18,  r28,  a8,  pk8,  ck8)
f_alert("MSFT",  p9,  bu9,  be9,  bc9,  tc9,  s19,  s29,  r19,  r29,  a9,  pk9,  ck9)
f_alert("GOOGL", p10, bu10, be10, bc10, tc10, s110, s210, r110, r210, a10, pk10, ck10)
f_alert("AMD",   p11, bu11, be11, bc11, tc11, s111, s211, r111, r211, a11, pk11, ck11)
f_alert("COIN",  p12, bu12, be12, bc12, tc12, s112, s212, r112, r212, a12, pk12, ck12)
f_alert("PLTR",  p13, bu13, be13, bc13, tc13, s113, s213, r113, r213, a13, pk13, ck13)
f_alert("NFLX",  p14, bu14, be14, bc14, tc14, s114, s214, r114, r214, a14, pk14, ck14)
f_alert("AVGO",  p15, bu15, be15, bc15, tc15, s115, s215, r115, r215, a15, pk15, ck15)
f_alert("BA",    p16, bu16, be16, bc16, tc16, s116, s216, r116, r216, a16, pk16, ck16)
f_alert("INTC",  p17, bu17, be17, bc17, tc17, s117, s217, r117, r217, a17, pk17, ck17)
f_alert("BAC",   p18, bu18, be18, bc18, tc18, s118, s218, r118, r218, a18, pk18, ck18)
f_alert("MU",    p19, bu19, be19, bc19, tc19, s119, s219, r119, r219, a19, pk19, ck19)
f_alert("DIS",   p20, bu20, be20, bc20, tc20, s120, s220, r120, r220, a20, pk20, ck20)

// ── Scanner Table (top-right) ─────────────────────────────────────────────────
var table t = table.new(position.top_right, 5, 22, bgcolor=color.new(color.black, 25), border_width=1, border_color=color.new(color.gray, 50))

f_row(int row, string d, float pr, int bsc, int esc, float rsi, bool vol) =>
    sc   = math.max(bsc, esc)
    sig  = bsc >= min_sc ? "B " + str.tostring(bsc) + "/11" : esc >= min_sc ? "S " + str.tostring(esc) + "/11" : str.tostring(sc) + "/11"
    scol = bsc >= min_sc ? color.new(color.green, 0) : esc >= min_sc ? color.new(color.red, 0) : color.new(color.gray, 0)
    table.cell(t, 0, row, d,                        text_color=color.white,                        text_size=size.small)
    table.cell(t, 1, row, str.tostring(pr, "#.##"), text_color=color.white,                        text_size=size.small)
    table.cell(t, 2, row, sig,                      text_color=scol,                               text_size=size.small)
    table.cell(t, 3, row, str.tostring(rsi, "#.#"), text_color=rsi > 50 ? color.lime : color.red,  text_size=size.small)
    table.cell(t, 4, row, vol ? "V" : "-",          text_color=vol ? color.lime : color.red,       text_size=size.small)

if barstate.isconfirmed
    table.cell(t, 0, 0, "Symbol",   text_color=color.yellow, text_size=size.small)
    table.cell(t, 1, 0, "Price",    text_color=color.yellow, text_size=size.small)
    table.cell(t, 2, 0, "Score/11", text_color=color.yellow, text_size=size.small)
    table.cell(t, 3, 0, "RSI",      text_color=color.yellow, text_size=size.small)
    table.cell(t, 4, 0, "Vol",      text_color=color.yellow, text_size=size.small)
    f_row(1,  "SPY",   p1,  bu1,  be1,  rs1,  v1)
    f_row(2,  "QQQ",   p2,  bu2,  be2,  rs2,  v2)
    f_row(3,  "IWM",   p3,  bu3,  be3,  rs3,  v3)
    f_row(4,  "AAPL",  p4,  bu4,  be4,  rs4,  v4)
    f_row(5,  "NVDA",  p5,  bu5,  be5,  rs5,  v5)
    f_row(6,  "TSLA",  p6,  bu6,  be6,  rs6,  v6)
    f_row(7,  "AMZN",  p7,  bu7,  be7,  rs7,  v7)
    f_row(8,  "META",  p8,  bu8,  be8,  rs8,  v8)
    f_row(9,  "MSFT",  p9,  bu9,  be9,  rs9,  v9)
    f_row(10, "GOOGL", p10, bu10, be10, rs10, v10)
    f_row(11, "AMD",   p11, bu11, be11, rs11, v11)
    f_row(12, "COIN",  p12, bu12, be12, rs12, v12)
    f_row(13, "PLTR",  p13, bu13, be13, rs13, v13)
    f_row(14, "NFLX",  p14, bu14, be14, rs14, v14)
    f_row(15, "AVGO",  p15, bu15, be15, rs15, v15)
    f_row(16, "BA",    p16, bu16, be16, rs16, v16)
    f_row(17, "INTC",  p17, bu17, be17, rs17, v17)
    f_row(18, "BAC",   p18, bu18, be18, rs18, v18)
    f_row(19, "MU",    p19, bu19, be19, rs19, v19)
    f_row(20, "DIS",   p20, bu20, be20, rs20, v20)

// ── Debug — TA calls at top level so Pine series remain consistent ─────────────
// All ta.* functions hoisted here regardless of show_dbg to avoid series warnings.
_d_pp    = (high[1] + low[1] + close[1]) / 3
_d_bc    = (high[1] + low[1]) / 2
_d_tc    = 2 * _d_pp - _d_bc
_d_ef    = ta.ema(close, ema_f)
_d_es    = ta.ema(close, ema_s)
_d_bbu   = ta.sma(close, bb_l) + bb_m * ta.stdev(close, bb_l)
_d_bbl   = ta.sma(close, bb_l) - bb_m * ta.stdev(close, bb_l)
_d_rsi   = ta.rsi(close, rsi_l)
_d_cmf   = ta.sma((high - low) > 0 ? ((close - low) - (high - close)) / (high - low) * volume : 0.0, cmf_l) / math.max(ta.sma(volume, cmf_l), 1)
_d_ich_c = (ta.highest(high, 9)  + ta.lowest(low, 9))  / 2
_d_ich_b = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2
_d_vsma  = ta.sma(volume, 20)

// Debug score breakdown dashboard — bottom-right, shows chart symbol only
var table dbg_t = table.new(position.bottom_right, 3, 10, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 60))

if show_dbg
    _c  = use_cpr  and close > _d_tc
    _bb = use_bb   and close > _d_bbu
    _e  = use_ema  and _d_ef > _d_es and close > _d_ef
    _r  = use_rsi  and _d_rsi > rsi_b
    _f  = use_cmf  and _d_cmf > cmf_t
    _i  = use_ichi and close > _d_ich_c and _d_ich_c > _d_ich_b
    _v  = use_vol  and volume > _d_vsma * vol_m and close > _d_tc
    _bull_sc = (_c ? W_CPR : 0) + (_bb ? W_BB : 0) + (_v ? W_VOL : 0) + (_e ? W_EMA : 0) + (_r ? W_RSI : 0) + (_f ? W_CMF : 0) + (_i ? W_ICH : 0)

    _c2  = use_cpr  and close < _d_bc
    _bb2 = use_bb   and close < _d_bbl
    _e2  = use_ema  and _d_ef < _d_es and close < _d_ef
    _r2  = use_rsi  and _d_rsi < rsi_br
    _f2  = use_cmf  and _d_cmf < -cmf_t
    _i2  = use_ichi and close < _d_ich_c and _d_ich_c < _d_ich_b
    _v2  = use_vol  and volume > _d_vsma * vol_m and close < _d_bc
    _bear_sc = (_c2 ? W_CPR : 0) + (_bb2 ? W_BB : 0) + (_v2 ? W_VOL : 0) + (_e2 ? W_EMA : 0) + (_r2 ? W_RSI : 0) + (_f2 ? W_CMF : 0) + (_i2 ? W_ICH : 0)

    if barstate.isconfirmed
        log.info(syminfo.ticker + " BULL: CPR" + (_c ? "+3" : " 0") + " BB" + (_bb ? "+2" : " 0") + " VOL" + (_v ? "+2" : " 0") + " EMA" + (_e ? "+1" : " 0") + " RSI" + (_r ? "+1" : " 0") + " CMF" + (_f ? "+1" : " 0") + " ICH" + (_i ? "+1" : " 0") + " = " + str.tostring(_bull_sc) + "/11  |  BEAR: CPR" + (_c2 ? "+3" : " 0") + " BB" + (_bb2 ? "+2" : " 0") + " VOL" + (_v2 ? "+2" : " 0") + " EMA" + (_e2 ? "+1" : " 0") + " RSI" + (_r2 ? "+1" : " 0") + " CMF" + (_f2 ? "+1" : " 0") + " ICH" + (_i2 ? "+1" : " 0") + " = " + str.tostring(_bear_sc) + "/11")

    if barstate.islast
        _gc  = color.new(color.green, 30)
        _rc  = color.new(color.red,   30)
        _dc  = color.new(color.gray,  70)
        _wc  = color.new(color.white,  0)
        _hc  = color.new(color.black, 30)

        table.cell(dbg_t, 0, 0, syminfo.ticker + " Score Debug", text_color=color.yellow, text_size=size.small, bgcolor=_hc)
        table.cell(dbg_t, 1, 0, "BULL",                          text_color=color.lime,   text_size=size.small, bgcolor=_hc)
        table.cell(dbg_t, 2, 0, "BEAR",                          text_color=color.red,    text_size=size.small, bgcolor=_hc)

        table.cell(dbg_t, 0, 1, "CPR (3 pts)",    text_color=_wc, text_size=size.small)
        table.cell(dbg_t, 1, 1, _ck(_c,   W_CPR), text_color=_wc, text_size=size.small, bgcolor=_c   ? _gc : _dc)
        table.cell(dbg_t, 2, 1, _ck(_c2,  W_CPR), text_color=_wc, text_size=size.small, bgcolor=_c2  ? _rc : _dc)

        table.cell(dbg_t, 0, 2, "Volume (2 pts)",  text_color=_wc, text_size=size.small)
        table.cell(dbg_t, 1, 2, _ck(_v,   W_VOL),  text_color=_wc, text_size=size.small, bgcolor=_v   ? _gc : _dc)
        table.cell(dbg_t, 2, 2, _ck(_v2,  W_VOL),  text_color=_wc, text_size=size.small, bgcolor=_v2  ? _rc : _dc)

        table.cell(dbg_t, 0, 3, "BB (2 pts)",     text_color=_wc, text_size=size.small)
        table.cell(dbg_t, 1, 3, _ck(_bb,  W_BB),  text_color=_wc, text_size=size.small, bgcolor=_bb  ? _gc : _dc)
        table.cell(dbg_t, 2, 3, _ck(_bb2, W_BB),  text_color=_wc, text_size=size.small, bgcolor=_bb2 ? _rc : _dc)

        table.cell(dbg_t, 0, 4, "EMA (1 pt)",     text_color=_wc, text_size=size.small)
        table.cell(dbg_t, 1, 4, _ck(_e,   W_EMA), text_color=_wc, text_size=size.small, bgcolor=_e   ? _gc : _dc)
        table.cell(dbg_t, 2, 4, _ck(_e2,  W_EMA), text_color=_wc, text_size=size.small, bgcolor=_e2  ? _rc : _dc)

        table.cell(dbg_t, 0, 5, "RSI (1 pt)",     text_color=_wc, text_size=size.small)
        table.cell(dbg_t, 1, 5, _ck(_r,   W_RSI), text_color=_wc, text_size=size.small, bgcolor=_r   ? _gc : _dc)
        table.cell(dbg_t, 2, 5, _ck(_r2,  W_RSI), text_color=_wc, text_size=size.small, bgcolor=_r2  ? _rc : _dc)

        table.cell(dbg_t, 0, 6, "CMF (1 pt)",     text_color=_wc, text_size=size.small)
        table.cell(dbg_t, 1, 6, _ck(_f,   W_CMF), text_color=_wc, text_size=size.small, bgcolor=_f   ? _gc : _dc)
        table.cell(dbg_t, 2, 6, _ck(_f2,  W_CMF), text_color=_wc, text_size=size.small, bgcolor=_f2  ? _rc : _dc)

        table.cell(dbg_t, 0, 7, "ICH (1 pt)",     text_color=_wc, text_size=size.small)
        table.cell(dbg_t, 1, 7, _ck(_i,   W_ICH), text_color=_wc, text_size=size.small, bgcolor=_i   ? _gc : _dc)
        table.cell(dbg_t, 2, 7, _ck(_i2,  W_ICH), text_color=_wc, text_size=size.small, bgcolor=_i2  ? _rc : _dc)

        _bcf = _cf(_bull_sc)
        _ecf = _cf(_bear_sc)
        table.cell(dbg_t, 0, 8, "TOTAL",                                          text_color=color.yellow, text_size=size.small, bgcolor=_hc)
        table.cell(dbg_t, 1, 8, str.tostring(_bull_sc) + "/11  [" + _bcf + "]",  text_color=color.lime,   text_size=size.small, bgcolor=_bull_sc >= min_sc ? _gc : _dc)
        table.cell(dbg_t, 2, 8, str.tostring(_bear_sc) + "/11  [" + _ecf + "]",  text_color=color.red,    text_size=size.small, bgcolor=_bear_sc >= min_sc ? _rc : _dc)

        _bfire = _bull_sc >= min_sc ? "ALERT ✅" : "need " + str.tostring(min_sc) + "+"
        _efire = _bear_sc >= min_sc ? "ALERT ✅" : "need " + str.tostring(min_sc) + "+"
        table.cell(dbg_t, 0, 9, "min=" + str.tostring(min_sc) + "/11", text_color=color.yellow, text_size=size.small, bgcolor=_hc)
        table.cell(dbg_t, 1, 9, _bfire,                                 text_color=color.white,  text_size=size.small, bgcolor=_bull_sc >= min_sc ? color.new(color.green, 10) : color.new(color.gray, 50))
        table.cell(dbg_t, 2, 9, _efire,                                 text_color=color.white,  text_size=size.small, bgcolor=_bear_sc >= min_sc ? color.new(color.red,   10) : color.new(color.gray, 50))
